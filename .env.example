# Required for live SERV Reasoning (server-only). Without it every SERV step
# uses a deterministic fallback and the app keeps working.
# Get a key at https://console.openserv.ai - never prefix with NEXT_PUBLIC_.
# Leave blank for now; fill later (do not reuse unrelated project keys casually).
SERV_API_KEY=

SERV_BASE_URL=https://inference-api.openserv.ai/v1

# Model routing (tiers: fast / small / large)
SERV_MODEL_FAST=gpt-5.4-mini
SERV_MODEL_SMALL=gpt-5.4-mini
SERV_MODEL_LARGE=gpt-5.4
# Optional aliases / per-step overrides:
# SERV_MODEL=gpt-5.4-mini
# SERV_TIER_INTENT=fast
# SERV_TIER_RAISE=small

# Public origin used in x402 resource URLs
NEXT_PUBLIC_APP_URL=http://localhost:3010

# Optional absolute path to kpass if not on PATH
# KPASS_BIN=/home/you/.local/bin/kpass
